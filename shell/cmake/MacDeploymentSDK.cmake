# macOS 27 SDKs cannot back-deploy to Catalina. Prefer an installed compatible
# SDK before project() performs its compiler checks; never rewrite the OS floor.
function(_flycast_sdk_versions sdk out_minimum out_version)
    if(EXISTS "${sdk}/SDKSettings.json")
        file(READ "${sdk}/SDKSettings.json" _settings)
        string(JSON _minimum ERROR_VARIABLE _min_error GET "${_settings}" SupportedTargets macosx MinimumDeploymentTarget)
        string(JSON _version ERROR_VARIABLE _version_error GET "${_settings}" Version)
        if(NOT _min_error AND NOT _version_error)
            set(${out_minimum} "${_minimum}" PARENT_SCOPE)
            set(${out_version} "${_version}" PARENT_SCOPE)
            return()
        endif()
    endif()
    set(${out_minimum} "" PARENT_SCOPE)
    set(${out_version} "" PARENT_SCOPE)
endfunction()

if(CMAKE_OSX_SYSROOT AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
    set(_flycast_sdk "${CMAKE_OSX_SYSROOT}")
else()
    set(_flycast_sdk_name macosx)
    if(CMAKE_OSX_SYSROOT)
        set(_flycast_sdk_name "${CMAKE_OSX_SYSROOT}")
    endif()
    execute_process(COMMAND xcrun --sdk "${_flycast_sdk_name}" --show-sdk-path
        OUTPUT_VARIABLE _flycast_sdk OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _flycast_sdk_result)
    if(NOT _flycast_sdk_result EQUAL 0)
        message(FATAL_ERROR "Cannot locate the macOS SDK: ${_flycast_sdk_name}")
    endif()
endif()
_flycast_sdk_versions("${_flycast_sdk}" _flycast_sdk_min _flycast_sdk_version)
if(NOT _flycast_sdk_min OR NOT CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS _flycast_sdk_min)
    return()
endif()
if(CMAKE_OSX_SYSROOT)
    message(FATAL_ERROR "SDK ${_flycast_sdk} requires macOS ${_flycast_sdk_min}; select a Catalina-compatible macOS 26 SDK for deployment target ${CMAKE_OSX_DEPLOYMENT_TARGET}")
endif()

set(_flycast_needs_metal4_sdk OFF)
if(NOT LIBRETRO AND (NOT DEFINED USE_METAL OR USE_METAL) AND "arm64" IN_LIST CMAKE_OSX_ARCHITECTURES)
    set(_flycast_needs_metal4_sdk ON)
endif()
get_filename_component(_flycast_sdk_dir "${_flycast_sdk}" DIRECTORY)
file(GLOB _flycast_sdk_candidates
    "${_flycast_sdk_dir}/MacOSX*.sdk"
    "/Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk"
    "/Applications/Xcode*.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX*.sdk")
set(_flycast_compatible_sdk "")
set(_flycast_compatible_version "0")
foreach(_candidate IN LISTS _flycast_sdk_candidates)
    _flycast_sdk_versions("${_candidate}" _minimum _version)
    if(NOT _minimum OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS _minimum)
        continue()
    endif()
    if(_flycast_needs_metal4_sdk AND _version VERSION_LESS "26.0")
        continue()
    endif()
    if(_version VERSION_GREATER _flycast_compatible_version)
        file(REAL_PATH "${_candidate}" _flycast_compatible_sdk)
        set(_flycast_compatible_version "${_version}")
    endif()
endforeach()
if(NOT _flycast_compatible_sdk)
    message(FATAL_ERROR "No installed SDK supports macOS ${CMAKE_OSX_DEPLOYMENT_TARGET}. Select Xcode 26.x (Metal 4 requires its macOS 26 SDK); the macOS 27 SDK requires macOS 12 or later.")
endif()
if(CMAKE_GENERATOR STREQUAL "Xcode")
    # Xcode 27 resolves external SDKs through its installed platform registry
    # and rejects an older Command Line Tools SDK even with an absolute path.
    message(FATAL_ERROR "The selected Xcode SDK requires macOS ${_flycast_sdk_min}. Select a full Xcode 26.x installation with DEVELOPER_DIR for a Catalina-compatible Xcode build, or use Ninja with -DCMAKE_OSX_SYSROOT=${_flycast_compatible_sdk}.")
endif()
message(STATUS "Using Catalina-compatible macOS ${_flycast_compatible_version} SDK: ${_flycast_compatible_sdk}")
set(CMAKE_OSX_SYSROOT "${_flycast_compatible_sdk}" CACHE PATH "macOS SDK compatible with deployment target" FORCE)
