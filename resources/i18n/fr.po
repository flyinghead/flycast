#: core/ui/settings_video.cpp:85
msgid "Graphics API"
msgstr "API Graphique"

#: core/ui/settings_video.cpp:96
msgid "MoltenVK: An implementation of Vulkan that runs on Apple's Metal graphics framework"
msgstr "MoltenVK : Une implémentation de Vulkan qui utilise l'API Metal d'Apple"

#: core/ui/settings_video.cpp:116
msgid "Transparent Sorting"
msgstr "Tri Surface Transparente"

#: core/ui/settings_video.cpp:121
msgid "Per Triangle"
msgstr "Par Triangle"

#: core/ui/settings_video.cpp:123
msgid "Sort transparent polygons per triangle. Fast but may produce graphical glitches"
msgstr "Trie les surfaces transparentes par triangle. Rapide mais peut produire des bogues graphiques"

#: core/ui/settings_video.cpp:125
msgid "Per Strip"
msgstr "Par Polygone"

#: core/ui/settings_video.cpp:127
msgid "Sort transparent polygons per strip. Faster but may produce graphical glitches"
msgstr "Trie les surfaces transparentes par polygone. Rapide mais peut produire des bogues graphiques"

#: core/ui/settings_video.cpp:131
msgid "Per Pixel"
msgstr "Par Pixel"

#: core/ui/settings_video.cpp:133
msgid "Sort transparent polygons per pixel. Slower but accurate"
msgstr "Trie les surfaces transparentes par pixel. Plus lent mais fidèle"

#: core/ui/settings_video.cpp:153
msgid "Rendering Options"
msgstr "Options de rendu"

#: core/ui/settings_video.cpp:156
msgid "Half"
msgstr "Moitié"

#: core/ui/settings_video.cpp:156 core/ui/settings_network.cpp:40
msgid "Native"
msgstr "Natif"

#: core/ui/settings_video.cpp:201
msgid "Internal Resolution"
msgstr "Résolution Interne"

#: core/ui/settings_video.cpp:203
msgid "Internal render resolution. Higher is better, but more demanding on the GPU. Values higher than your display resolution (but no more than double your display resolution) can be used for supersampling, which provides high-quality antialiasing without reducing sharpness."
msgstr "Résolution de rendu interne. Les valeurs plus élevées produisent des images plus fines mais consomment plus de ressources. Les valeurs supérieures à votre résolution d'écran produisent du sur-échantillonnage."

#: core/ui/settings_video.cpp:204
msgid "Integer Scaling"
msgstr "Échelle Entière"

#: core/ui/settings_video.cpp:204
msgid "Scales the output by the maximum integer multiple allowed by the display resolution."
msgstr "Augmente la résolution externe par paliers entiers."

#: core/ui/settings_video.cpp:205
msgid "Linear Interpolation"
msgstr "Interpolation Linéaire"

#: core/ui/settings_video.cpp:205
msgid "Scales the output with linear interpolation. Will use nearest neighbor interpolation otherwise. Disable with integer scaling."
msgstr "Utilise l'interpolation linéaire pour l'affichage final."

#: core/ui/settings_video.cpp:207
msgid "VSync"
msgstr "Synchronisation Verticale"

#: core/ui/settings_video.cpp:207
msgid "Synchronizes the frame rate with the screen refresh rate. Recommended"
msgstr "Synchronise la production d'image avec la fréquence de rafraîchissement de l'écran. Recommandé"

#: core/ui/settings_video.cpp:212
msgid "Frame Pacing (Experimental)"
msgstr "Synchronisation de Trame (Expérimental)"

#: core/ui/settings_video.cpp:213
msgid "Provide the GPU with presentation timing for each frame to replicate original frame pacing."
msgstr "Fournit au GPU des informations temporelles pour chaque trame afin de répliquer la cadence originale."

#: core/ui/settings_video.cpp:216
msgid "Duplicate frames"
msgstr "Duplication des Trames"

#: core/ui/settings_video.cpp:216
msgid "Duplicate frames on high refresh rate monitors (120 Hz and higher)"
msgstr "Duplique les trames sur les moniteurs à haute fréquence de rafraîchissement (120 Hz et au-delà)"

#: core/ui/settings_video.cpp:221
msgid "Show VMU In-game"
msgstr "Affichage LCD VMU"

#: core/ui/settings_video.cpp:221
msgid "Show the VMU LCD screens while in-game"
msgstr "Affiche les écrans LCD VMU pendant le jeu"

#: core/ui/settings_video.cpp:223
msgid "Show VMU on Secondary Display"
msgstr "Afficher le VMU sur Écran Secondaire"

#: core/ui/settings_video.cpp:224
msgid "Show the VMU LCD screen of controller A on the secondary display, if any"
msgstr "Affiche l'écran LCD du VMU sur l'écran secondaire si disponible"

#: core/ui/settings_video.cpp:228
msgid "Secondary Display Scaling:"
msgstr "Mise à l'Échelle Écran Secondaire :"

#: core/ui/settings_video.cpp:230
msgid "Fit"
msgstr "Ajuster"

#: core/ui/settings_video.cpp:230
msgid "Scale the VMU screen to fill as much of the display as possible while keeping its aspect ratio"
msgstr "Maintient les proportions de l'écran du VMU tout en utilisant le maximum d'espace d'écran possible"

#: core/ui/settings_video.cpp:232
msgid "Integer"
msgstr "Entier"

#: core/ui/settings_video.cpp:232
msgid "Scale the VMU screen by the largest whole number that fits, for evenly sized pixels"
msgstr "Met à l'échelle l'écran du VMU par un facteur entier pour des pixels de taille identique"

#: core/ui/settings_video.cpp:234
msgid "Stretch"
msgstr "Étirer"

#: core/ui/settings_video.cpp:234
msgid "Stretch the VMU screen to fill the whole display, ignoring its aspect ratio"
msgstr "Étire l'écran du VMU pour utiliser tout l'espace disponible"

#: core/ui/settings_video.cpp:239
msgid "Full Framebuffer Emulation"
msgstr "Émulation Framebuffer Complète"

#: core/ui/settings_video.cpp:240
msgid "Fully accurate VRAM framebuffer emulation. Helps games that directly access the framebuffer for special effects. Very slow and incompatible with upscaling and wide screen."
msgstr "Émulation complète du framebuffer en VRAM. Améliore les jeux qui accèdent directement au framebuffer pour des effets spéciaux. Très lent et incompatible avec résolution interne et écran large."

#: core/ui/settings_video.cpp:242
msgid "Load Custom Textures"
msgstr "Chargement Textures Personnalisées"

#: core/ui/settings_video.cpp:243
msgid "Load custom/high-res textures from data/textures/<game id>. Supports KTX2/XUBC7, KTX2/XUASTC, KTX2/ETC1S, DDS/BC7, PNG, and JPEG."
msgstr "Charge les textures personnalisées de data/textures/<game id>. Supporte KTX2/XUBC7, KTX2/XUASTC, KTX2/ETC1S, DDS/BC7, PNG, et JPEG."

#: core/ui/settings_video.cpp:252
msgid "Custom Texture Preloading"
msgstr "Préchargement des Textures Personnalisées"

#: core/ui/settings_video.cpp:254
msgid "Off"
msgstr "Désactivé"

#: core/ui/settings_video.cpp:257
msgid "Load custom textures as needed."
msgstr "Charge les textures personnalisées quand nécessaire."

#: core/ui/settings_video.cpp:259
msgid "System Memory"
msgstr "Mémoire Système"

#: core/ui/settings_video.cpp:262
msgid "Preload custom textures at game start to prevent texture popping. Consumes system memory for the entire texture pack."
msgstr "Précharge les textures personnalisées au démarrage du jeu pour éviter les changements de textures. Utilise de la mémoire système pour l'ensemble du paquet."

#: core/ui/settings_video.cpp:266
msgid "Video Memory"
msgstr "Mémoire Vidéo"

#: core/ui/settings_video.cpp:271
msgid "Preload custom textures at game start to prevent texture popping. Consumes video memory for the entire texture pack."
msgstr "Précharge les textures personnalisées au démarrage du jeu pour éviter les changements de textures. Utilise de la mémoire vidéo pour l'ensemble du paquet."

#: core/ui/settings_video.cpp:272
msgid "Video-memory custom texture preloading is not supported by the current renderer."
msgstr "Le préchargement de textures personnalisées en mémoire vidéo n'est pas supporté par le moteur de rendu courant."

#: core/ui/settings_video.cpp:281
msgid "Aspect Ratio"
msgstr "Format d'Image"

#: core/ui/settings_video.cpp:283
msgid "Widescreen"
msgstr "Écran Large"

#: core/ui/settings_video.cpp:284
msgid "Draw geometry outside of the normal 4:3 aspect ratio. May produce graphical glitches in the revealed areas.\n"
"Aspect Fit and shows the full 16:9 content."
msgstr "Affiche la géométrie en dehors du format normal 4:3. Peut produire des bogues graphiques dans les zones larges.\n"
"Affiche l'écran 16:9 complet."

#: core/ui/settings_video.cpp:289
msgid "Super Widescreen"
msgstr "Écran Super Large"

#: core/ui/settings_video.cpp:290
msgid "Use the full width of the screen or window when its aspect ratio is greater than 16:9.\n"
"Aspect Fill and remove black bars. Not compatible with integer scaling."
msgstr "Utilise la largeur complète l'écran ou de la fenêtre lorsque son format est supérieur à 16:9.\n"
"Remplit l'écran cible et élimine les barres noires. Incompatible avec Échelle Entière."

#: core/ui/settings_video.cpp:293
msgid "Widescreen Game Cheats"
msgstr "Codes de Triche Écran Large"

#: core/ui/settings_video.cpp:294
msgid "Modify the game so that it displays in 16:9 anamorphic format and use horizontal screen stretching. Only some games are supported."
msgstr "Modifie le jeu pour qu'il affiche son image en 16:9 anamorphique, et utilise l'étirement horizontal. Seuls certains jeux sont supportés."

#: core/ui/settings_video.cpp:297
msgid "Stretch to Fill"
msgstr "Étirer en Largeur"

#: core/ui/settings_video.cpp:298
msgid "Stretch the screen to fill the entire screen or window."
msgstr "Étire l'image pour occuper la largeur complète de l'écran ou de la fenêtre."

#: core/ui/settings_video.cpp:302
msgid "Horizontal Stretching"
msgstr "Étirement Horizontal"

#: core/ui/settings_video.cpp:303
msgid "Stretch the screen horizontally"
msgstr "Augmente la largeur de l'écran"

#: core/ui/settings_video.cpp:305
msgid "Rotate Screen 90°"
msgstr "Rotation Écran 90°"

#: core/ui/settings_video.cpp:305
msgid "Rotate the screen 90° counterclockwise"
msgstr "Effectue une rotation de l'écran de 90° dans le sens anti-horaire"

#: core/ui/settings_video.cpp:310
msgid "Per Pixel Settings"
msgstr "Préférences Par Pixel"

#: core/ui/settings_video.cpp:313
msgid "512 MB"
msgstr "512 Mo"

#: core/ui/settings_video.cpp:313
msgid "1 GB"
msgstr "1 Go"

#: core/ui/settings_video.cpp:313
msgid "2 GB"
msgstr "2 Go"

#: core/ui/settings_video.cpp:313
msgid "4 GB"
msgstr "4 Go"

#: core/ui/settings_video.cpp:351
msgid "Pixel Buffer Size"
msgstr "Taille Tampon Pixels"

#: core/ui/settings_video.cpp:353
msgid "The size of the pixel buffer. May need to be increased when upscaling by a large factor."
msgstr "La taille du tampon de pixels. Augmenter la résolution interne demande un tampon de pixels plus grand."

#: core/ui/settings_video.cpp:355
msgid "Maximum Layers"
msgstr "Couches Maximum"

#: core/ui/settings_video.cpp:356
msgid "Maximum number of transparent layers. May need to be increased for some complex scenes. Decreasing it may improve performance."
msgstr "Nombre maximum de couches transparentes. Des scènes complexes peuvent nécessiter plus de couches. Diminuer le nombre de couches peut augmenter les performances."

#: core/ui/settings_video.cpp:359
msgid "Performance"
msgstr "Performances"

#: core/ui/settings_video.cpp:361
msgid "Automatic Frame Skipping:"
msgstr "Saut d'Image Automatique :"

#: core/ui/settings_video.cpp:363 core/ui/settings_video.cpp:388
#: core/ui/settings_network.cpp:89
msgid "Disabled"
msgstr "Désactivé"

#: core/ui/settings_video.cpp:363
msgid "No frame skipping"
msgstr "Pas de saut"

#: core/ui/settings_video.cpp:365
msgid "Normal"
msgstr "Normal"

#: core/ui/settings_video.cpp:365
msgid "Skip a frame when the GPU and CPU are both running slow"
msgstr "Saute une image quand le CPU et le GPU sont surchargés"

#: core/ui/settings_video.cpp:367
msgid "Maximum"
msgstr "Maximum"

#: core/ui/settings_video.cpp:367
msgid "Skip a frame when the GPU is running slow"
msgstr "Saute une image quand le GPU est surchargé"

#: core/ui/settings_video.cpp:370
msgid "Frame Skipping"
msgstr "Saut d'Image"

#: core/ui/settings_video.cpp:371
msgid "Number of frames to skip between two actually rendered frames"
msgstr "Nombre d'images à sauter entre chaque image affichée"

#: core/ui/settings_video.cpp:372
msgid "Shadows"
msgstr "Ombres"

#: core/ui/settings_video.cpp:373
msgid "Enable modifier volumes, usually used for shadows"
msgstr "Active les \"modifier volumes\", habituellement utilisés pour générer des ombres portées"

#: core/ui/settings_video.cpp:374
msgid "Fog"
msgstr "Brouillard"

#: core/ui/settings_video.cpp:374
msgid "Enable fog effects"
msgstr "Active les effets de brouillard"

#: core/ui/settings_video.cpp:377 core/ui/settings.cpp:311
msgid "Advanced"
msgstr "Avancé"

#: core/ui/settings_video.cpp:379
msgid "Delay Frame Swapping"
msgstr "Délai Échange de Trame"

#: core/ui/settings_video.cpp:380
msgid "Useful to avoid flashing screen or glitchy videos. Not recommended on slow platforms"
msgstr "Utile pour éviter les écrans clignotants et les problèmes vidéo. Pas recommandé sur les plateformes lentes"

#: core/ui/settings_video.cpp:381
msgid "Fix Upscale Bleeding Edge"
msgstr "Correction du Bord Débordant des Textures"

#: core/ui/settings_video.cpp:382
msgid "Helps with texture bleeding case when upscaling. Disabling it can help if pixels are warping when upscaling in 2D games (MVC2, CVS, KOF, etc.)"
msgstr "Améliore les problèmes de bord débordant des textures avec une résolution interne non native. Peut créer des problèmes avec certains jeux 2D (MvsC2, CVS, KOF, etc.)"

#: core/ui/settings_video.cpp:383
msgid "Native Depth Interpolation"
msgstr "Interpolation Profondeur Native"

#: core/ui/settings_video.cpp:384
msgid "Helps with texture corruption and depth issues on AMD GPUs. Can also help Intel GPUs in some cases."
msgstr "Améliore les problèmes de corruption de texture et problèmes de profondeur avec les processeurs graphiques AMD. Peut aussi aider avec les processeurs Intel dans certains cas."

#: core/ui/settings_video.cpp:385
msgid "Copy Rendered Textures to VRAM"
msgstr "Copie Textures Générés en VRAM"

#: core/ui/settings_video.cpp:386
msgid "Copy rendered-to textures back to VRAM. Slower but accurate"
msgstr "Copie les textures générées par le jeu en VRAM. Plus lent mais plus fidèle"

#: core/ui/settings_video.cpp:425
msgid "Anisotropic Filtering"
msgstr "Filtre Anisotrope"

#: core/ui/settings_video.cpp:427
msgid "Higher values make textures viewed at oblique angles look sharper, but are more demanding on the GPU. This option only has a visible impact on mipmapped textures."
msgstr "Les valeurs plus élevées rendent les textures vues sous un angle obliques plus précises, mais demandent plus de puissance graphique. Cette option n'a un impact visible que sur les textures avec mipmap."

#: core/ui/settings_video.cpp:429
msgid "Texture Filtering:"
msgstr "Filtrage Texture :"

#: core/ui/settings_video.cpp:431 core/ui/settings_general.cpp:237
#: core/ui/settings_general.cpp:241 core/ui/settings_general.cpp:246
msgid "Default"
msgstr "Défaut"

#: core/ui/settings_video.cpp:431
msgid "Use the game's default texture filtering"
msgstr "Utiliser le filtre demandé par le jeu"

#: core/ui/settings_video.cpp:433
msgid "Force Nearest-Neighbor"
msgstr "Forcer Proche Voisin"

#: core/ui/settings_video.cpp:433
msgid "Force nearest-neighbor filtering for all textures. Crisper appearance, but may cause various rendering issues. This option usually does not affect performance."
msgstr "Force le filtrage plus proche voisin sur toutes les textures. Apparence plus nette, mais peut causer des problèmes de rendu graphique. Cette option normalement n'affecte pas les performances."

#: core/ui/settings_video.cpp:435
msgid "Force Linear"
msgstr "Forcer Linéaire"

#: core/ui/settings_video.cpp:435
msgid "Force linear filtering for all textures. Smoother appearance, but may cause various rendering issues. This option usually does not affect performance."
msgstr "Force le filtrage linéaire sur toutes les textures. Apparence plus réaliste, mais peut causer des problèmes de rendu graphique. Cette option normalement n'affecte pas les performances."

