#: core/ui/settings_video.cpp:116
msgid "Transparent Sorting"
msgstr "透明物体顺序渲染"

#: core/ui/settings_video.cpp:121
msgid "Per Triangle"
msgstr "按三角形计算"

#: core/ui/settings_video.cpp:123
msgid "Sort transparent polygons per triangle. Fast but may produce graphical glitches"
